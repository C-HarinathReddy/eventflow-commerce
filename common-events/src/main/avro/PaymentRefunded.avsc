{
  "type": "record",
  "name": "PaymentRefunded",
  "namespace": "com.jamespolk.ordertracking.events",
  "doc": "Compensation for a cancelled order. Published by payment-service to payment-events.",
  "fields": [
    {"name": "eventId",    "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "orderId",    "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "occurredAt", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "amount", "type": {"type": "bytes", "logicalType": "decimal", "precision": 12, "scale": 2}}
  ]
}
